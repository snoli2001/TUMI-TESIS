generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["tumi"]
}

model Organization {
  sourceId      String         @id @map("source_id")
  name          String
  logoSourceUrl String?        @map("logo_source_url")
  logoR2Key     String?        @map("logo_r2_key")
  lists         ElectionList[]

  @@map("organizations")
  @@schema("tumi")
}

model Department {
  code String @id
  name String

  @@map("departments")
  @@schema("tumi")
}

model Province {
  code           String @id
  name           String
  departmentCode String @map("department_code")

  @@map("provinces")
  @@schema("tumi")
}

model District {
  code           String @id
  name           String
  provinceCode   String @map("province_code")
  departmentCode String @map("department_code")

  @@map("districts")
  @@schema("tumi")
}

model ElectionList {
  sourceId             String       @id @map("source_id")
  codigoExpediente     String       @map("codigo_expediente")
  organizationSourceId String       @map("organization_source_id")
  departmentCode       String?      @map("department_code")
  provinceCode         String?      @map("province_code")
  districtCode         String?      @map("district_code")
  organization         Organization @relation(fields: [organizationSourceId], references: [sourceId])
  plan                 Plan?        @relation(fields: [codigoExpediente], references: [codigoExpediente])
  candidates           Candidate[]

  @@map("lists")
  @@schema("tumi")
}

model Candidate {
  hojaVidaId      String       @id @map("hoja_vida_id")
  listSourceId    String       @map("list_source_id")
  numeroCandidato Int          @map("numero_candidato")
  nombres         String
  apellidoPaterno String       @map("apellido_paterno")
  apellidoMaterno String       @map("apellido_materno")
  cargoEleccion   String       @map("cargo_eleccion")
  estadoCandidato String       @default("") @map("estado_candidato")
  photoSourceUrl  String?      @map("photo_source_url")
  photoR2Key      String?      @map("photo_r2_key")
  list            ElectionList @relation(fields: [listSourceId], references: [sourceId])
  resume          Resume?

  @@map("candidates")
  @@schema("tumi")
}

model Resume {
  hojaVidaId         String               @id @map("hoja_vida_id")
  sexo               String?
  fechaNacimiento    String?              @map("fecha_nacimiento")
  cargo              String?
  primaryCompleted   Boolean?             @map("primary_completed")
  secondaryCompleted Boolean?             @map("secondary_completed")
  candidate          Candidate            @relation(fields: [hojaVidaId], references: [hojaVidaId])
  work               ResumeWork[]
  education          ResumeEducation[]
  elected            ResumeElected[]
  resignations       ResumeResignation[]
  income             ResumeIncome[]
  properties         ResumeProperty[]
  vehicles           ResumeVehicle[]
  criminal           ResumeCriminal[]
  obligation         ResumeObligation[]

  @@map("resumes")
  @@schema("tumi")
}

model ResumeWork {
  id                  BigInt  @id @default(autoincrement())
  hojaVidaId          String  @map("hoja_vida_id")
  sourceId            String  @map("source_id")
  centroTrabajo       String? @map("centro_trabajo")
  ocupacionProfesion  String? @map("ocupacion_profesion")
  anioDesde           String? @map("anio_desde")
  anioHasta           String? @map("anio_hasta")
  departamento        String?
  provincia           String?
  distrito            String?
  resume              Resume  @relation(fields: [hojaVidaId], references: [hojaVidaId], onDelete: Cascade)

  @@map("resume_work")
  @@schema("tumi")
}

model ResumeEducation {
  id          BigInt  @id @default(autoincrement())
  hojaVidaId  String  @map("hoja_vida_id")
  sourceId    String  @map("source_id")
  universidad   String?
  carrera       String?
  anioBachiller String? @map("anio_bachiller")
  completed     Boolean?
  resume       Resume  @relation(fields: [hojaVidaId], references: [hojaVidaId], onDelete: Cascade)

  @@map("resume_education")
  @@schema("tumi")
}

model ResumeElected {
  id          BigInt  @id @default(autoincrement())
  hojaVidaId  String  @map("hoja_vida_id")
  sourceId    String  @map("source_id")
  orgPolitica String? @map("org_politica")
  cargo       String?
  anioDesde   String? @map("anio_desde")
  anioHasta   String? @map("anio_hasta")
  resume      Resume  @relation(fields: [hojaVidaId], references: [hojaVidaId], onDelete: Cascade)

  @@map("resume_elected")
  @@schema("tumi")
}

model ResumeResignation {
  id          BigInt  @id @default(autoincrement())
  hojaVidaId  String  @map("hoja_vida_id")
  sourceId    String  @map("source_id")
  orgPolitica String? @map("org_politica")
  anio        String?
  resume      Resume  @relation(fields: [hojaVidaId], references: [hojaVidaId], onDelete: Cascade)

  @@map("resume_resignations")
  @@schema("tumi")
}

model ResumeIncome {
  id         BigInt  @id @default(autoincrement())
  hojaVidaId String  @map("hoja_vida_id")
  sourceId   String  @map("source_id")
  anio       String?
  total      String?
  resume     Resume  @relation(fields: [hojaVidaId], references: [hojaVidaId], onDelete: Cascade)

  @@map("resume_income")
  @@schema("tumi")
}

model ResumeProperty {
  id         BigInt  @id @default(autoincrement())
  hojaVidaId String  @map("hoja_vida_id")
  sourceId   String  @map("source_id")
  tipo       String?
  direccion  String?
  autovaluo  String?
  resume     Resume  @relation(fields: [hojaVidaId], references: [hojaVidaId], onDelete: Cascade)

  @@map("resume_properties")
  @@schema("tumi")
}

model ResumeVehicle {
  id         BigInt  @id @default(autoincrement())
  hojaVidaId String  @map("hoja_vida_id")
  sourceId   String  @map("source_id")
  placa      String?
  valor      String?
  resume     Resume  @relation(fields: [hojaVidaId], references: [hojaVidaId], onDelete: Cascade)

  @@map("resume_vehicles")
  @@schema("tumi")
}

model ResumeCriminal {
  id             BigInt  @id @default(autoincrement())
  hojaVidaId     String  @map("hoja_vida_id")
  sourceId       String  @map("source_id")
  materia        String?
  expediente     String?
  fechaSentencia String? @map("fecha_sentencia")
  fallo          String?
  resume         Resume  @relation(fields: [hojaVidaId], references: [hojaVidaId], onDelete: Cascade)

  @@map("resume_criminal")
  @@schema("tumi")
}

model ResumeObligation {
  id             BigInt  @id @default(autoincrement())
  hojaVidaId     String  @map("hoja_vida_id")
  sourceId       String  @map("source_id")
  materia        String?
  expediente     String?
  fechaSentencia String? @map("fecha_sentencia")
  fallo          String?
  resume         Resume  @relation(fields: [hojaVidaId], references: [hojaVidaId], onDelete: Cascade)

  @@map("resume_obligation")
  @@schema("tumi")
}

model Plan {
  codigoExpediente String          @id @map("codigo_expediente")
  ideario          String?
  vision           String?
  fullPdfSourceUrl    String? @map("full_pdf_source_url")
  summaryPdfSourceUrl String? @map("summary_pdf_source_url")
  fullPdfR2Key        String? @map("full_pdf_r2_key")
  summaryPdfR2Key     String? @map("summary_pdf_r2_key")
  lists            ElectionList[]
  dimensions       PlanDimension[]

  @@map("plans")
  @@schema("tumi")
}

model PlanDimension {
  id               BigInt         @id @default(autoincrement())
  codigoExpediente String         @map("codigo_expediente")
  name             String
  plan             Plan           @relation(fields: [codigoExpediente], references: [codigoExpediente], onDelete: Cascade)
  proposals        PlanProposal[]

  @@map("plan_dimensions")
  @@schema("tumi")
}

model PlanProposal {
  id          BigInt        @id @default(autoincrement())
  dimensionId BigInt        @map("dimension_id")
  itemIndex   Int           @map("item_index")
  problema    String?
  objetivo    String?
  indicador   String?
  meta        String?
  dimension   PlanDimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  @@map("plan_proposals")
  @@schema("tumi")
}

model Gestor {
  id           String          @id @db.Uuid
  email        String          @unique
  name         String
  passwordHash String          @map("password_hash")
  createdAt    DateTime        @default(now()) @map("created_at")
  sessions     GestorSession[]

  @@map("gestors")
  @@schema("tumi")
}

model GestorSession {
  id        String   @id @db.Uuid
  gestorId  String   @map("gestor_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  gestor    Gestor   @relation(fields: [gestorId], references: [id], onDelete: Cascade)

  @@index([gestorId])
  @@map("gestor_sessions")
  @@schema("tumi")
}

model FactSession {
  id            String     @id @db.Uuid
  accessKeyHash String?    @map("access_key_hash")
  createdAt     DateTime   @default(now()) @map("created_at")
  turns         FactTurn[]

  @@map("fact_sessions")
  @@schema("tumi")
}

model CandidateDocument {
  id           String    @id @db.Uuid
  hojaVidaId   String    @map("hoja_vida_id")
  originalName String    @map("original_name")
  storageName  String    @unique @map("storage_name")
  byteSize     Int       @map("byte_size")
  status       String    @default("pending")
  pageCount    Int?      @map("page_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([hojaVidaId, status])
  @@map("candidate_documents")
  @@schema("tumi")
}

model FactTurn {
  id         BigInt      @id @default(autoincrement())
  sessionId  String      @map("session_id") @db.Uuid
  role       String
  content    String
  verdict    String?
  confidence Float?
  sources    Json
  choices    Json
  createdAt  DateTime    @default(now()) @map("created_at")
  session    FactSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, id])
  @@map("fact_turns")
  @@schema("tumi")
}
