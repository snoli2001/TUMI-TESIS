# Misma DATABASE_URL que tumi2 en la rama qas (Postgres goberlab, esquema tumi).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/goberlab
REDIS_URL=redis://localhost:6379
# Qdrant externo. No va en el Compose. QDRANT_API_KEY solo si el servidor la pide.
QDRANT_URL=http://HOST:6333
QDRANT_API_KEY=
PORT=3000
WEB_PORT=8080

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_MODEL_MINI=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_DECISION_MODEL=gpt-6-luna
DECISION_MIN_CONFIDENCE=0.55
DECISION_RELEVANCE_MIN=0.4

TAVILY_API_KEY=
JNE_API_BASE_URL=
# Misma base que tumi2. La clave del archivo vive en summary_pdf_r2_key.
R2_PUBLIC_BASE_URL=https://goberlab-cdn.astra-consulting.tech

AUTH_ENABLED=false
API_TOKEN=
# Cuenta inicial del gestor. Si la tabla tumi.gestors está vacía, el arranque crea esta cuenta.
GESTOR_EMAIL=
GESTOR_PASSWORD=
CONSULTA_RETENTION_DAYS=30
DOCUMENT_RETENTION_DAYS=365
DOCUMENT_MAX_BYTES=15728640
# Fuera del directorio público. En Compose es /data/documents.
DOCUMENT_DIR=
# El worker no recorre los planes al arrancar. Para indexarlos: node apps/worker/dist/index-plans.js
INDEX_PLANS_ON_START=false
